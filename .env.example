### Runtime
DEBUG=False
TIMEZONE=Asia/Seoul

### App Base
BASE_URL=https://sandol.sio2.kr/kakao-bot
LOGIN_CALLBACK_URL=https://sandol.sio2.kr/kakao-bot/users/callback
# Optional safe relative path only. Example: /auth/realms/Sandori/account/
LOGIN_REDIRECT_AFTER=

### Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./kakao_bot_service.db
CACHE_DIR=./.cache

### Internal Service URLs (MSA)
# 같은 망이면 http://auth-relay:8000/relay, 인증 서버가 다른 망이면 공개 HTTPS(https://<인증 도메인>/relay).
# 어느 쪽이든 issue_login_link는 RELAY_ISSUE_LINK_SECRET으로 서명해 보낸다(TLS 검증은 기본값 유지).
AUTH_RELAY_URL=http://auth-relay:8000/relay
MEAL_SERVICE_URL=http://meal-service:80/meal
STATIC_INFO_SERVICE_URL=http://static-info-service:80/static-info
NOTICE_SERVICE_URL=http://notice-notification:3000/notice-notification
CLASSROOM_TIMETABLE_SERVICE_URL=http://classroom-timetable-service:80/classroom-timetable

### Help Block (기본값 사용 가능, 빈 값으로 두면 "도움말" 메시지 발화로 대체)
HELP_BLOCK_ID=67218b3757cc8a7ef532157e

### External Links
WEEKLY_MENU_URL=https://ibook.tukorea.ac.kr/Viewer/menu02

### Keycloak
KC_SERVER_URL=https://sandol.sio2.kr/auth/
KC_CLIENT_ID=sandol-kakao-bot
KC_REALM=Sandori
KC_CLIENT_SECRET=*****
# 토큰 갱신이 invalid_grant로 거절될 때 DB의 저장 토큰을 지울지 여부.
# Keycloak 분리·issuer 전환 같은 작업 중에만 false로 두는 임시 운영 스위치다.
# false면 만료 사용자의 요청마다 refresh가 재시도된다. issuer 불일치도
# invalid_grant라 이 스위치만이 대량 삭제를 막는다.
KC_TOKEN_PURGE_ENABLED=true

### Security
TOKEN_ENCRYPTION_KEY=*****
RELAY_CLIENT_SECRETS=dev-hmac-secret-please-change
# issue_login_link 요청 서명 비밀. auth-relay의 SANDOL_KAKAO_BOT__ISSUE_LINK_SECRET과 같은 값
RELAY_ISSUE_LINK_SECRET=dev-issue-link-secret-please-change
NONCE_TTL_SECONDS=300

### Request Timeouts
# 서버 처리 예산은 카카오 플랫폼의 5초 제한보다 짧게 설정한다.
KAKAO_REQUEST_TIMEOUT_SECONDS=4.0
# HTTP 단계별 대기는 서버 처리 예산보다 짧게 설정한다.
DOWNSTREAM_HTTP_TIMEOUT_SECONDS=3.0
DOWNSTREAM_HTTP_CONNECT_TIMEOUT_SECONDS=1.0
